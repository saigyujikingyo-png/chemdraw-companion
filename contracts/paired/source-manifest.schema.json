{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chembridge.invalid/contracts/paired/source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "paired-source-manifest/1.0"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "author_or_project": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "original_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "asset_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "redistributable": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_evidence_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "container": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "member": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stream": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "sha256",
                "member",
                "stream"
              ]
            }
          ]
        }
      },
      "required": [
        "source_url",
        "citation",
        "author_or_project",
        "retrieved_at",
        "original_sha256",
        "asset_types",
        "redistributable",
        "license",
        "license_evidence_url",
        "container"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "relative_locator": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "relative_locator",
          "sha256",
          "bytes",
          "media_type"
        ]
      }
    },
    "raw_asset_distribution": {
      "const": "private_only"
    },
    "retrieval_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "version",
    "sample_id",
    "source",
    "assets",
    "raw_asset_distribution",
    "retrieval_notes"
  ]
}
