{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chembridge:chemdraw:output:help-data:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {
      "enum": [
        "recipe",
        "error",
        "style",
        "capability",
        "recovery"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "schema_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "schema_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "item_id",
          "summary"
        ]
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "topic",
    "items",
    "next_cursor"
  ]
}
